# Leave VITE_SUPABASE_URL empty (or set to "auto") to reach Supabase through a
# same-origin proxy (Vite in dev, nginx in the Docker build). This avoids
# cross-origin CORS preflights and ngrok's free-tier browser interstitial.
# Set an explicit URL instead to talk to Supabase cross-origin (hosted).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
VITE_SUPABASE_ANON_KEY=<anon-key>
